# .env.example
# Defaults for the isolated, credential-free local stack. Copy to .env only
# when running the API directly on the host; never reuse these values in production.

# --- APP SETTINGS ---
ENV=dev
LOG_LEVEL=INFO
LOCAL_LOAD_TEST_CACHE_BYPASS_ENABLED=true
JWT_SECRET_KEY=local-dev-only-change-me
LOCAL_BIND_ADDRESS=127.0.0.1
API_LOCAL_PORT=18000

# --- DATABASE (Aurora Postgres) ---
POSTGRES_PORT=15432
DATABASE_URL=postgresql+asyncpg://ragadmin:changeme@localhost:15432/rag_db

# --- CACHE (Redis) ---
REDIS_PORT=16379
REDIS_URL=redis://localhost:16379/0

# --- VECTOR DB (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=16333
QDRANT_COLLECTION=rag_collection

# --- GRAPH DB (Neo4j) ---
NEO4J_HTTP_PORT=17474
NEO4J_BOLT_PORT=17687
NEO4J_URI=bolt://localhost:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- LOCAL S3 EMULATOR ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_NAME=rag-platform-docs-dev
S3_EMULATOR_PORT=14566
S3_ENDPOINT_URL=http://localhost:14566
EVAL_EVIDENCE_BUCKET=eval-traces

# --- EVALUATION EVIDENCE DELIVERY (opt-in) ---
# Off by default. `make local-evidence-up` enables delivery and synthetic content capture
# through docker-compose.evaluation.yml, with its own dummy identity key; never set the
# flags here. SQS shares the emulator port; 123456789012 is Moto's default account.
EVAL_EVIDENCE_ENABLED=false
EVAL_CAPTURE_CONTENT=false
EVAL_QUEUE_NAME=eval-runs
EVAL_DLQ_NAME=eval-runs-dlq
EVAL_QUEUE_URL=http://localhost:14566/123456789012/eval-runs
EVAL_S3_BUCKET=eval-traces
EVAL_S3_ENDPOINT_URL=http://localhost:14566
EVAL_KMS_KEY_ID=local-evidence-kms-key

# --- MODEL ENDPOINTS ---
# By default the local profile uses deterministic CPU-only fakes on port 8001.
# To use hosted models, copy this file to .env and set the corresponding API
# endpoint, key, and model below. docker-compose passes these settings only to
# api-local; credentials are not baked into the image. Leave an endpoint blank
# to keep using the fake/Ray endpoint for that component.
RAY_LLM_ENDPOINT=http://localhost:8001/v1/chat/completions
RAY_EMBED_ENDPOINT=http://localhost:8001/api/embeddings
LLM_MODEL_NAME=fake-local-llm
# OpenAI example: https://api.openai.com/v1/chat/completions and
# https://api.openai.com/v1/embeddings. OpenRouter example:
# https://openrouter.ai/api/v1/chat/completions and
# https://openrouter.ai/api/v1/embeddings. Set LLM_API_ENDPOINT, LLM_API_KEY,
# and LLM_MODEL_NAME for hosted chat; set EMBED_API_ENDPOINT, EMBED_API_KEY
# (or reuse LLM_API_KEY), EMBED_MODEL_NAME, and its correct EMBED_DIM for hosted
# embeddings. For OpenRouter reranking, also set RERANK_API_ENDPOINT,
# RERANK_MODEL_NAME, and optionally RERANK_API_KEY (defaults to LLM_API_KEY).
LLM_API_ENDPOINT=
LLM_API_KEY=
EMBED_API_ENDPOINT=
EMBED_API_KEY=

# EMBED_MODEL_NAME must match the endpoint. The fake model needs no task prefix.
# Ollama's nomic-embed-text does; production BAAI/bge-m3 does not. A mismatch
# silently changes retrieval quality even though requests still succeed.
EMBED_MODEL_NAME=fake-local-embed
EMBED_DIM=1024
# OpenRouter provides the optional rerank endpoint. It is disabled when blank.
# Example endpoint: https://openrouter.ai/api/v1/rerank; use a rerank model slug.
RERANK_API_ENDPOINT=
RERANK_API_KEY=
RERANK_MODEL_NAME=

# --- OBSERVABILITY ---
OTEL_GRPC_PORT=14317
OTEL_HTTP_PORT=14318
OTEL_HEALTH_PORT=13134
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14317
OTEL_SERVICE_NAME=rag-api-service
OTEL_SERVICE_VERSION=local-dev
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_EXPORTER_OTLP_TIMEOUT=5
OTEL_CONSOLE_EXPORT_ENABLED=false
