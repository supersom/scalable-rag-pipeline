# .env.example
# Defaults for the isolated, credential-free local stack. Copy to .env only
# when running the API directly on the host; never reuse these values in production.

# --- APP SETTINGS ---
ENV=dev
LOG_LEVEL=INFO
JWT_SECRET_KEY=local-dev-only-change-me
LOCAL_BIND_ADDRESS=127.0.0.1
API_LOCAL_PORT=18000

# --- DATABASE (Aurora Postgres) ---
POSTGRES_PORT=15432
DATABASE_URL=postgresql+asyncpg://ragadmin:changeme@localhost:15432/rag_db

# --- CACHE (Redis) ---
REDIS_PORT=16379
REDIS_URL=redis://localhost:16379/0

# --- VECTOR DB (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=16333
QDRANT_COLLECTION=rag_collection

# --- GRAPH DB (Neo4j) ---
NEO4J_HTTP_PORT=17474
NEO4J_BOLT_PORT=17687
NEO4J_URI=bolt://localhost:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- LOCAL S3 EMULATOR ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_NAME=rag-platform-docs-dev
S3_EMULATOR_PORT=14566
S3_ENDPOINT_URL=http://localhost:14566
EVAL_EVIDENCE_BUCKET=eval-traces

# --- MODEL ENDPOINTS ---
# The local profile serves deterministic CPU-only fakes on port 8001. Override
# these values when intentionally testing Ollama, Ray Serve, or a hosted model.
RAY_LLM_ENDPOINT=http://localhost:8001/v1/chat/completions
RAY_EMBED_ENDPOINT=http://localhost:8001/api/embeddings
LLM_MODEL_NAME=fake-local-llm

# EMBED_MODEL_NAME must match the endpoint. The fake model needs no task prefix.
# Ollama's nomic-embed-text does; production BAAI/bge-m3 does not. A mismatch
# silently changes retrieval quality even though requests still succeed.
EMBED_MODEL_NAME=fake-local-embed
EMBED_DIM=1024

# --- OBSERVABILITY ---
OTEL_GRPC_PORT=14317
OTEL_HTTP_PORT=14318
OTEL_HEALTH_PORT=13134
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14317
