# .env.example
# Copy this to .env and fill in the values

# --- APP SETTINGS ---
ENV=dev
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_secure_random_string_for_jwt

# --- DATABASE (Aurora Postgres) ---
DATABASE_URL=postgresql+asyncpg://ragadmin:changeme@localhost:5432/rag_db

# --- CACHE (Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- VECTOR DB (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=rag_collection

# --- GRAPH DB (Neo4j) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- AWS (Infrastructure) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=rag-platform-docs-dev

# --- RAY CLUSTER (AI Engines) ---
# In K8s, these point to internal Service DNS
# Locally, you might port-forward
RAY_LLM_ENDPOINT=http://localhost:8000/llm
RAY_EMBED_ENDPOINT=http://localhost:8000/embed

# EMBED_MODEL_NAME must name whichever model actually answers RAY_EMBED_ENDPOINT — the client
# uses it to decide whether to add nomic-embed-text's required search_query/search_document
# task prefix. Locally with Ollama this is nomic-embed-text (needs the prefix). In K8s prod,
# embed-service serves BAAI/bge-m3 (deploy/ray/ray-serve-embed.yaml's EMBED_MODEL_ID) — bge-m3
# explicitly does NOT want a prefix, so set this to "BAAI/bge-m3" there (already done in
# deploy/helm/api/values.yaml and deploy/k8s/ingestion-worker.yaml — this line only matters for
# local runs). Getting this wrong doesn't error, it silently prefixes text the model wasn't
# trained to expect, or omits a prefix the model requires — both degrade retrieval quietly.
EMBED_MODEL_NAME=nomic-embed-text

# --- OBSERVABILITY ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317