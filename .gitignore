.env*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo

# Claude Code internal directory
.claude/

# Agent tooling local state (CodeGraph index, Codex CLI marker, self-improvement log)
.codegraph/
.codex
.worktrees/
.learnings/

# Terraform plugin cache and local state (state lives in S3)
**/.terraform/
*.tfstate
*.tfstate.backup

# Local data / eval datasets (large binary files, not source)
data/
noisy_data/
eval/datasets/noisy_data/
eval/datasets/ingested/
eval/datasets/digested/
eval/datasets/failed/
infra/terraform/terraform.tfvars
infra/terraform/*.tfvars
infra/terraform-staging/terraform.tfvars
infra/terraform-staging/*.tfvars
.venv-eval/
eval/runs/
eval/datasets/eval_corpus/
