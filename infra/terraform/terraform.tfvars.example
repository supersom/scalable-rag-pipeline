# Copy to terraform.tfvars and fill in values.
# terraform.tfvars is gitignored — never commit real passwords.

# ── Required ──────────────────────────────────────────────────────────────────

db_password = "change-me"

# ── Database tier ─────────────────────────────────────────────────────────────
# "rds"    — db.t3.micro RDS PostgreSQL, ~$15/month, no HA  (default, dev/test)
# "aurora" — Serverless v2 Aurora, ~$86/month minimum, multi-AZ HA (production)

db_tier = "rds"

# ── Optional third-party API keys ────────────────────────────────────────────
# Uncomment and fill in to enable the corresponding agent tool. Leaving unset
# is fully supported — the tool degrades gracefully instead of erroring.

# tavily_api_key = "tvly-..."  # web_search tool (https://tavily.com)

# ── Optional one-off ingestion source ────────────────────────────────────────
# Grants the ingestion role read-only access to an external bucket's "pdfs/"
# prefix, for backfilling from a source outside the pipeline's own documents
# bucket. Leave unset to skip provisioning this extra grant.

# ingestion_source_bucket = "my-external-kb-bucket"

# ── Optional overrides ────────────────────────────────────────────────────────

# aws_region   = "us-east-1"
# cluster_name = "rag-platform-cluster"
# environment  = "prod"
# vpc_cidr     = "10.0.0.0/16"
